# iSolarCloud Portal Giriş Ayarları
ISOLAR_BASE_URL=https://www.isolarcloud.com/
ISOLAR_USERNAME=your_username_here
ISOLAR_PASSWORD=your_password_here
ISOLAR_HEADLESS=true

# Dizin Yapılandırması
LOG_DIR=logs
RAW_EXPORTS_DIR=outputs/raw_exports
REPORT_OUTPUT_DIR=outputs/pdf
CHART_OUTPUT_DIR=outputs/charts

# Uygulama Ortamı (development, production)
APP_ENV=production

# Veritabanı Yapılandırması
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/solar_report_db

# SMTP E-Posta Yapılandırması
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# Dashboard Yapılandırması
DASHBOARD_PORT=8080
DASHBOARD_ACCESS_MODE=localhost

# Playwright Tarayıcı Dizini (SUNUCUDA ZORUNLU)
# Tanımlı değilse Playwright tarayıcıları %USERPROFILE%\AppData\Local\ms-playwright
# altında arar — bu yol HESABA BAĞLIDIR. Dashboard görevi SYSTEM hesabında koştuğu için
# (scripts/setup_dashboard_task_server.ps1) profil yolu
# C:\Windows\system32\config\systemprofile\... olur ve kullanıcı profiline yapılmış
# kurulum görünmez. Makine geneli tek dizin bu sorunu kapatır.
# DİKKAT: Önce kurulumu yapın, SONRA bu satırı .env'e ekleyin — sıra tersse
# hâlihazırda çalışan zamanlanmış job'lar boş dizine bakar:
#   setx /M PLAYWRIGHT_BROWSERS_PATH C:\ProgramData\ms-playwright
#   $env:PLAYWRIGHT_BROWSERS_PATH="C:\ProgramData\ms-playwright"; .venv\Scripts\playwright install chromium
PLAYWRIGHT_BROWSERS_PATH=C:\ProgramData\ms-playwright

# GAOSB Tarayıcı Modu
# new    = yeni headless Chromium (varsayılan; aktif masaüstü oturumu gerektirmez,
#          BotGuard clearance profildeyken captcha görmeden çalışır)
# headed = her zaman görünür tarayıcı (eski davranış, geri dönüş anahtarı)
GAOSB_HEADLESS_MODE=new
